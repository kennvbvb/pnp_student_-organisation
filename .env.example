# --- Local development (SQLite file) ---
# ใช้ตอน dev บนเครื่อง (Prisma migrate/seed อ่านค่านี้)
DATABASE_URL="file:./dev.db"

# --- Production (Turso / libSQL) ---
# ตั้งค่าบน Vercel เท่านั้น ถ้ามี TURSO_DATABASE_URL แอปจะใช้ค่านี้แทน DATABASE_URL
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<your-turso-auth-token>"

# Secret สำหรับเซ็น session JWT — ต้องเปลี่ยนเป็นค่าสุ่มยาวๆ ใน production
SESSION_SECRET="change-this-to-a-long-random-string"

# บัญชี admin เริ่มต้น (ใช้เฉพาะตอนรัน prisma/seed.ts)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
