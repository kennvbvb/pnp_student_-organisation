// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PRESIDENT
  VICE_PRESIDENT
  DEPT_HEAD
  MEMBER
}

enum WasteTargetType {
  ROOM
  STUDENT
}

enum ConductEntryType {
  ADD
  DEDUCT
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  fullName           String
  role               Role
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  permissions       UserPermission[]
  loginLogs         LoginLog[]
  auditLogs         AuditLog[]
  conductDeductions ConductDeduction[]
  planActivities    PlanActivity[]
  wasteScoreEntries WasteScoreEntry[]

  cancelledConductDeductions ConductDeduction[] @relation("ConductCancelledBy")
  cancelledWasteScoreEntries WasteScoreEntry[]  @relation("WasteCancelledBy")
}

model UserPermission {
  id         String @id @default(cuid())
  userId     String
  permission String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  // Actor snapshot: keeps "who did it" readable even after the user row
  // is deleted or renamed.
  actorUsername String?
  actorFullName String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model CouncilPosition {
  id             String   @id @default(cuid())
  title          String
  parentId       String?
  sortOrder      Int      @default(0)
  holderName     String?
  holderStudentId String?
  photoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   CouncilPosition?  @relation("PositionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CouncilPosition[] @relation("PositionHierarchy")
  holderStudent Student?     @relation(fields: [holderStudentId], references: [id], onDelete: SetNull)

  @@index([parentId])
}

model Student {
  id           String   @id @default(cuid())
  studentCode  String   @unique
  prefix       String?
  firstName    String
  lastName     String
  classRoom    String
  conductScore Int      @default(100)
  active       Boolean  @default(true)
  // ปีการศึกษา (พ.ศ.) ที่จบการศึกษา/พ้นสภาพ — set by the year-rollover wizard.
  graduatedYear Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conductDeductions ConductDeduction[]
  wasteScoreEntries WasteScoreEntry[]
  councilPositions  CouncilPosition[]

  @@index([classRoom])
}

model ConductDeduction {
  id                String           @id @default(cuid())
  studentId         String
  type              ConductEntryType @default(DEDUCT)
  amount            Int
  reason            String
  category          String?
  recordedByUserId  String?
  academicYearId    String?
  createdAt         DateTime         @default(now())
  // Soft cancellation: entries are never hard-deleted, only cancelled with a reason.
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  cancelledBy  User?         @relation("ConductCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([createdAt])
  @@index([cancelledAt])
  @@index([academicYearId])
}

model ConductReason {
  id        String           @id @default(cuid())
  text      String           @unique
  type      ConductEntryType @default(DEDUCT)
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
}

model PlanActivity {
  id              String    @id @default(cuid())
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime?
  month           Int
  year            Int
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([startDate])
}

model WasteType {
  id            String   @id @default(cuid())
  name          String   @unique
  unit          String
  pointsPerUnit Float
  createdAt     DateTime @default(now())

  wasteScoreEntries WasteScoreEntry[]
}

model WasteScoreEntry {
  id                String          @id @default(cuid())
  targetType        WasteTargetType
  classRoom         String?
  studentId         String?
  wasteTypeId       String
  quantity          Float
  pointsAwarded     Float
  note              String?
  recordedByUserId  String?
  academicYearId    String?
  createdAt         DateTime        @default(now())
  // Soft cancellation: entries are never hard-deleted, only cancelled with a reason.
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?

  student      Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  wasteType    WasteType     @relation(fields: [wasteTypeId], references: [id])
  recordedBy   User?         @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  cancelledBy  User?         @relation("WasteCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([classRoom])
  @@index([createdAt])
  @@index([cancelledAt])
  @@index([academicYearId])
}

model SiteSetting {
  key   String @id
  value String
}

// ปีการศึกษา (Thai academic year, starts in May). Exactly one row has
// isCurrent = true; closed years are read-only for score entries.
model AcademicYear {
  id        String    @id @default(cuid())
  year      Int       @unique // พ.ศ. เช่น 2569
  isCurrent Boolean   @default(false)
  closed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  conductDeductions ConductDeduction[]
  wasteScoreEntries WasteScoreEntry[]
}
